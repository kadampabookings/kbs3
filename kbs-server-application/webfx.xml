<?xml version="1.0" encoding="UTF-8"?>
<project>

    <description>The KBS Server application (cross-platform non-executable module).</description>

    <exported-packages>
        <source-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules/>

        <plugin-module>modality-base-server-max-plugin</plugin-module> <!-- includes some standard configuration -->
        <plugin-module>modality-base-server-dbmigration-plugin</plugin-module> <!-- applies bundled DB migrations at boot -->
        <plugin-module>modality-base-server-mailer-plugin</plugin-module> <!-- drains the mail table & transmits (KBS2 handover); inert until MAILER_ENABLED -->
        <plugin-module>modality-base-server-webpushmailer-plugin</plugin-module> <!-- drains channel='push' mails as Web Push notifications; inert until WEBPUSH_MAILER_ENABLED -->
        <plugin-module>modality-crm-server-max-plugin</plugin-module>
        <plugin-module>modality-ecommerce-server-max-plugin</plugin-module>
        <plugin-module>modality-event-server-max-plugin</plugin-module>
        <plugin-module>modality-event-server-media-plugin</plugin-module> <!-- deleting a teaching session and its media, as an endpoint rather than as SQL a client sends -->
        <plugin-module>modality-event-server-lifecycle-plugin</plugin-module> <!-- duplicating an event with its programme, one transaction, same reason -->
        <plugin-module>modality-hotel-server-resource-plugin</plugin-module> <!-- deleting a room and its configurations, same reason -->
        <plugin-module>modality-crm-server-person-plugin</plugin-module> <!-- merging a duplicate person, the last of step 1's six statements -->

        <plugin-module>kbs-server-podcastsimport-plugin</plugin-module>
        <plugin-module>kbs-server-newsimport-plugin</plugin-module>
        <plugin-module>kbs-server-videosimport-plugin</plugin-module>

<!-- These jobs are run occasionally on dev machines, so commented by default.
        <plugin-module>modality-base-server-geoimport-plugin</plugin-module>
        <plugin-module>kbs-server-kdmimport-plugin</plugin-module>
        <plugin-module>kbs-server-organisation-update-plugin</plugin-module>
-->

        <!-- Adding config resolutions from environment variables (used in AWS) -->
        <plugin-module>webfx-platform-substitution-var-env-plugin</plugin-module>
        <!-- Lets a developer type a secret at startup instead of storing it (ex: password = ${{ KBS_DATABASE_PASSWORD | prompt:KBS_DATABASE_PASSWORD }}).
             Inert unless a conf value uses the prompt: prefix, and never blocks without a desktop or terminal. -->
        <plugin-module>webfx-platform-substitution-var-prompt-jre-plugin</plugin-module>

        <!-- We use Bunny for the images hosting -->
        <plugin-module>webfx-stack-cloud-image-bunny-plugin</plugin-module>

    </dependencies>
</project>