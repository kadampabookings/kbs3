<?xml version="1.0" encoding="UTF-8"?>
<project name="kbs3">

    <description>Kadampa Booking System (3rd generation) built on top of Modality &amp; WebFX.</description>

    <parent name="webfx-parent"/>

    <groupId>org.kadampabookings</groupId>
    <version>1.0.0-SNAPSHOT</version>

    <modules>
        <subdirectories-modules/>
    </modules>

    <required-libraries>
        <webfx-library artifact="one.modality:modality:1.0.0-SNAPSHOT"/>
    </required-libraries>

    <maven-repositories>
        <webfx-repository/>
        <snapshot-repository id="modality-snapshots">https://s01.oss.sonatype.org/content/repositories/snapshots/</snapshot-repository>
    </maven-repositories>

    <maven-pom-manual>
        <properties>
            <scram.version>3.2</scram.version>
            <stringprep.version>2.2</stringprep.version>
        </properties>

        <dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>com.ongres.scram</groupId>
                    <artifactId>scram-client</artifactId>
                    <version>${scram.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.ongres.scram</groupId>
                    <artifactId>scram-common</artifactId>
                    <version>${scram.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.ongres.stringprep</groupId>
                    <artifactId>saslprep</artifactId>
                    <version>${stringprep.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.ongres.stringprep</groupId>
                    <artifactId>stringprep</artifactId>
                    <version>${stringprep.version}</version>
                </dependency>
            </dependencies>
        </dependencyManagement>
    </maven-pom-manual>

</project>