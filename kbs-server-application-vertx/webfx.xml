<?xml version="1.0" encoding="UTF-8"?>
<project executable="true">

    <description>The Vert.x executable module of the KBS Server.</description>

    <exported-packages>
        <source-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules/>
        <plugin-module>webfx-platform-console-sl4j-plugin</plugin-module>
        <!-- This is to get correct logs on AWS (multi-line output in 1 single log entry) -->
        <plugin-module>logback-classic</plugin-module>
        <plugin-module>logstash-logback-encoder</plugin-module> <!-- see logback.xml in resources -->
    </dependencies>

    <required-libraries>

        <library>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.38</version>
        </library>

        <library>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version> <!-- 9.x is on Jackson 3, aligned with Vert.x by the tools.jackson bom in kbs3/webfx.xml -->
        </library>

    </required-libraries>

    <maven-pom-manual>
        <dependencyManagement>
            <dependencies>
                <!-- This is to remove the following warning:
            SLF4J(W): Class path contains multiple SLF4J providers.
            SLF4J(W): Found provider [ch.qos.logback.classic.spi.LogbackServiceProvider@3c756e4d]
            SLF4J(W): Found provider [org.slf4j.jul.JULServiceProvider@7c0e2abd]
                 -->
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-jdk14</artifactId>
                    <scope>provided</scope>
                </dependency>
            </dependencies>

        </dependencyManagement>

        <!-- The list of the server's Java libraries, for the security watch (kbs-server-securitywatch-plugin): the fat jar
             carries none of its own, because shading drops every library's META-INF/maven/** (webfx-parent's shade
             filter). Written at prepare-package into the module's classes, so the jar - and the fat jar built from it -
             holds it as the resource kbs/security-watch/java-libraries.txt: one "groupId:artifactId:type[:classifier]:version"
             line per runtime library (dependency:list's format, without the scope), after a header line. A run from the
             IDE does not execute it: there the check reads the class path's jars instead, a partial list. -->
        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.9.0</version>
                    <executions>
                        <execution>
                            <id>security-watch-java-libraries</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>list</goal>
                            </goals>
                            <configuration>
                                <includeScope>runtime</includeScope>
                                <sort>true</sort>
                                <outputScope>false</outputScope>
                                <appendOutput>false</appendOutput>
                                <outputFile>${project.build.outputDirectory}/kbs/security-watch/java-libraries.txt</outputFile>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
    </maven-pom-manual>

</project>